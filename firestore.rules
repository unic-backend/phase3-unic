rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPERS ====================

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Email du token (le bon chemin: request.auth.token.email)
    function emailEstAdmin() {
      return isAuth()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'admin@unicplaquiste.com',
          'unicplaquiste@gmail.com',
          'odiop2020@gmail.com'
        ];
    }

    // Le profil users/{uid} porte le flag isAdmin == true
    // exists() évite l'erreur si le profil n'existe pas (PAS de try/catch en Firestore)
    function profilEstAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isAdmin() {
      return emailEstAdmin() || profilEstAdmin();
    }

    // ==================== users ====================
    match /users/{userId} {
      allow read:   if isAuth() && (isOwner(userId) || isAdmin());
      allow create: if isAuth() && (isOwner(userId) || isAdmin());
      allow update: if isAuth() && (isOwner(userId) || isAdmin());
      allow delete: if false;
    }

    // ==================== quotes (devis) ====================
    match /quotes/{quoteId} {
      allow create: if isAuth() && (request.resource.data.clientId == request.auth.uid || isAdmin());
      allow read:   if isAuth() && (resource.data.clientId == request.auth.uid || isAdmin())
                    // Lecture publique par token de signature (lien WhatsApp envoyé au client)
                    || resource.data.signatureToken != null;
      allow update: if isAuth() && isAdmin()
                    // Le client signe via son token unique : seuls les champs signature sont modifiables
                    || resource.data.signatureToken != null
                       && request.resource.data.signatureToken == resource.data.signatureToken
                       && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['signatureClient', 'signatureClientDate', 'status', 'updatedAt']);
      // Suppression: uniquement un devis Rejeté (sans valeur business active),
      // par le client concerné ou l'admin. Jamais En attente ou Approuvé.
      allow delete: if isAuth() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid
      );
    }

    // ==================== invoices (factures) ====================
    match /invoices/{invoiceId} {
      allow read:   if isAuth() && (resource.data.clientId == request.auth.uid || isAdmin())
                    // Lecture publique par token de signature (lien WhatsApp envoyé au client)
                    || resource.data.signatureToken != null;
      allow create: if isAuth() && isAdmin();
      // Admin: tout modifier. Client connecté: passer SA facture en "En vérification".
      // Client via token: signer (seuls les champs signature sont modifiables).
      allow update: if isAuth() && (
        isAdmin() ||
        (resource.data.clientId == request.auth.uid
          && request.resource.data.status == 'En vérification'
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.clientId == resource.data.clientId)
      )
      || resource.data.signatureToken != null
         && request.resource.data.signatureToken == resource.data.signatureToken
         && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['signatureClient', 'signatureClientDate', 'status', 'updatedAt']);
      allow delete: if isAuth() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid
      );
    }

    // ==================== messages (chat) ====================
    match /messages/{messageId} {
      // Lecture: le client voit sa conversation, l'admin voit tout
      allow read: if isAuth() && (resource.data.clientId == request.auth.uid || isAdmin());
      // Création: le client ne peut écrire QUE dans SA propre conversation,
      // l'admin peut écrire dans n'importe quelle conversation
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid && (
        (request.resource.data.senderRole == 'client' && request.resource.data.clientId == request.auth.uid) ||
        (isAdmin() && request.resource.data.senderRole == 'admin')
      );
      // Mise à jour (marquer lu): même accès que la lecture
      allow update: if isAuth() && (resource.data.clientId == request.auth.uid || isAdmin());
      // Suppression: seulement l'auteur du message (annuler son propre envoi),
      // ou un admin pour modération
      allow delete: if isAuth() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // ==================== projects (projets) ====================
    match /projects/{projectId} {
      allow read:   if isAuth() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isAdmin();
      allow update: if isAuth() && isAdmin();
      // Suppression: admin uniquement (le client ne peut pas effacer le suivi de chantier)
      allow delete: if isAuth() && isAdmin();
    }

    // ==================== notifications ====================
    match /notifications/{notifId} {
      // Lecture: le client voit les siennes, l'admin voit celles marquées forAdmins
      allow read: if isAuth() && (
        (resource.data.forAdmins == true && isAdmin()) ||
        resource.data.userId == request.auth.uid
      );
      // Création: un admin peut notifier n'importe qui (client précis).
      // Un client ne peut créer QUE des notifications partagées admin (forAdmins),
      // jamais cibler un autre client.
      allow create: if isAuth() && (
        isAdmin() ||
        (request.resource.data.forAdmins == true && request.resource.data.userId == null)
      );
      // Mise à jour (marquer lue): même règle que la lecture
      allow update: if isAuth() && (
        (resource.data.forAdmins == true && isAdmin()) ||
        resource.data.userId == request.auth.uid
      );
      // Suppression: chacun efface les siennes ; l'admin efface celles forAdmins
      allow delete: if isAuth() && (
        (resource.data.forAdmins == true && isAdmin()) ||
        resource.data.userId == request.auth.uid
      );
    }

    // ==================== prospects (page publique /discussion) ====================
    // uid = l'id du document = l'uid de la session anonyme du visiteur.
    // Limite de 30 messages par discussion : protection contre les coûts/abus
    // puisque le lien est public et générique (pas unique par prospect).
    match /prospects/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && (
        (request.auth.uid == uid && request.resource.data.messages.size() <= 30) ||
        isAdmin()
      );
      allow delete: if isAuth() && isAdmin();
    }

    // ==================== depenses ====================
    match /depenses/{id} {
      allow read, write: if isAdmin();
    }

    // ==================== portfolio ====================
    match /portfolio/{id} {
      allow read: if true; // Public : visible sur le site, utilisé par l'IA
      allow write: if isAdmin();
    }

    // ==================== opportunites ====================
    match /opportunites/{id} {
      allow read, write: if isAdmin();
    }

    // ==================== parametres (signature admin, etc.) ====================
    match /parametres/{id} {
      // Lecture : tout utilisateur connecté — nécessaire pour que la signature
      // UniC apparaisse sur les PDF téléchargés par les CLIENTS (devis/factures).
      // Écriture : admin uniquement (personne d'autre ne peut changer la signature).
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ==================== base_connaissances (IA) ====================
    // Réservé aux admins : c'est leur outil interne, pas une donnée client.
    match /base_connaissances/{id} {
      allow read, write: if isAdmin();
    }

    // ==================== stories ====================
    // L'admin publie ; tous les clients connectés lisent.
    // Un client peut incrémenter vues/clics sur SA participation uniquement
    // (les autres champs — média, texte, action — restent intouchables).
    match /stories/{storyId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isAdmin();
      allow delete: if isAuth() && isAdmin();
      allow update: if isAuth() && (
        isAdmin() ||
        // Client : uniquement mise à jour des compteurs vues/clics
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['vues', 'vuePar', 'vuesDetail', 'clics', 'clicPar', 'clicsDetail'])
      );
    }

    // ==================== DÉFAUT: tout bloquer ====================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
