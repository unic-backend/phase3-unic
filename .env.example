# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Email Configuration (for Cloud Functions)
GMAIL_EMAIL=your_gmail_here
GMAIL_PASSWORD=your_gmail_app_password_here

# Assistant IA (fonction Netlify functions/ia-chat.js)
# ⚠️ À définir UNIQUEMENT dans Netlify > Site settings > Environment variables.
# Ne JAMAIS mettre la vraie clé dans ce fichier ni dans le code.
CLAUDE_API_KEY=your_claude_api_key_here

# Sentry (Error Tracking)
VITE_SENTRY_DSN=your_sentry_dsn_here
