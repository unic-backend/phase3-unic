rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photos des projets : tout le monde connecté peut LIRE,
    // mais seuls les admins peuvent ENVOYER (write).
    match /projets/{projetId}/{fichier} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'admin@unicplaquiste.com',
          'unicplaquiste@gmail.com',
          'odiop2020@gmail.com'
        ]
        // Sécurité: max 10 Mo, et uniquement des images
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Tout le reste bloqué
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
